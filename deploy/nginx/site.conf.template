# MissionCopilot {{ENV}}: {{HOSTNAME}} -> 127.0.0.1:{{PORT}} (#103 step 6). Rendered by
# scripts/render_nginx_site.py into its own file in sites-available; nothing else is changed.
# Rules pinned by scripts/test_render_nginx_site.py; behaviour checked by scripts/container_check.py.

# Loose per address: officers share one (a hotel's Wi-Fi, a carrier's NAT). The strict limit is
# per phone, in the app, after its signature checked out.
limit_req_zone $binary_remote_addr zone=mc_{{ENV}}_addr:10m rate=20r/s;

server {
{{LISTEN_HTTP}}
    server_name {{HOSTNAME}};
    server_tokens off;
    access_log /var/log/nginx/missioncopilot-{{ENV}}.access.log;
    error_log /var/log/nginx/missioncopilot-{{ENV}}.error.log;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{{LISTEN_HTTPS}}
    server_name {{HOSTNAME}};
    server_tokens off;
    access_log /var/log/nginx/missioncopilot-{{ENV}}.access.log;
    error_log /var/log/nginx/missioncopilot-{{ENV}}.error.log;

    # Mozilla intermediate: TLS 1.2 and 1.3, forward-secret AEAD ciphers. No OCSP stapling: Let's
    # Encrypt ended OCSP in 2025. HSTS comes from the app itself on every answer.
    ssl_certificate {{CERT_DIR}}/fullchain.pem;
    ssl_certificate_key {{CERT_DIR}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    client_max_body_size 1m;  # the app's own limit
    limit_req zone=mc_{{ENV}}_addr burst=40 nodelay;
    limit_req_status 429;
    error_page 429 = @mc_too_many;
    error_page 502 503 504 = @mc_unavailable;  # the app restarting or down: a clean "try later"

    # Set here only: a proxy_set_header inside a location would drop all of these.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;  # overwrite: the client cannot add to it
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    send_timeout 120s;

    # No URI part: the path reaches the app exactly as the phone signed it.
    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
    }

    # Pack files: the bytes untouched (the strong ETag must hold for resume), one range only,
    # and time for slow links.
    location ~ ^/v1/missions/[^/]+/pack/files/ {
        proxy_pass http://127.0.0.1:{{PORT}};
        gzip off;
        max_ranges 1;
        proxy_read_timeout 300s;
        send_timeout 300s;
    }

    location @mc_too_many {
        default_type application/problem+json;
        add_header Retry-After 1 always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429}';
    }

    location @mc_unavailable {
        default_type application/problem+json;
        add_header Retry-After 5 always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 503 '{"type":"about:blank","title":"Service Unavailable","status":503}';
    }
}
