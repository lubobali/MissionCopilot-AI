<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Debug builds only. Merged into the generated Info.plist so Finder can copy model files
     into the app for spikes. UIFileSharingEnabled has no INFOPLIST_KEY_ build setting.
     The launch screen is the same as in Info.plist (checked by scripts/test_ios_project.py). -->
<plist version="1.0">
<dict>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Debug only (#90): plain http to the local server on this Mac (localhost, .local).
             No other exception; the Release build has none at all. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>MCServerScheme</key>
    <string>$(MC_SERVER_SCHEME)</string>
    <key>MCServerHost</key>
    <string>$(MC_SERVER_HOST)</string>
    <key>MCServerKeys</key>
    <string>$(MC_SERVER_KEYS)</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIImageName</key>
        <string>LaunchLogo</string>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIFileSharingEnabled</key>
    <true/>
</dict>
</plist>
