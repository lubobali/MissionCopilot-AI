{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lubobali/MissionCopilot-AI/docs/api/pack-sections.schema.json",
  "title": "Mission pack sections (#89)",
  "description": "What each file of a mission pack holds: sections/<name>.json and forms/road-checklist.json. Field names follow supervision data (ratings, results, disbursement) and OC4IDS 0.9.5 for the project, contract, milestones and locations. Strict: an unknown field is refused, so the app's decoder and the server cannot drift.",
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalDate",
        "budget",
        "closingDate",
        "country",
        "currency",
        "developmentObjective",
        "implementingAgency",
        "note",
        "projectRef",
        "sector",
        "site",
        "status",
        "title"
      ],
      "properties": {
        "projectRef": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "sector": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "identification",
            "preparation",
            "implementation",
            "completion",
            "maintenance",
            "decommissioning",
            "decommissioned",
            "cancelled"
          ]
        },
        "developmentObjective": {
          "type": "string",
          "minLength": 1
        },
        "implementingAgency": {
          "type": "string",
          "minLength": 1
        },
        "approvalDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "closingDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "currency"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cost",
              "disbursed",
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "cost": {
                "type": "integer",
                "minimum": 0
              },
              "disbursed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asOf",
        "environmentalSocial",
        "financialManagement",
        "implementationProgress",
        "overallRisk",
        "pdoProgress",
        "procurement"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "pdoProgress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "previous": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            },
            "current": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            }
          }
        },
        "implementationProgress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "previous": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            },
            "current": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            }
          }
        },
        "procurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "previous": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            },
            "current": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            }
          }
        },
        "financialManagement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "previous": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            },
            "current": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            }
          }
        },
        "environmentalSocial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "previous": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            },
            "current": {
              "enum": [
                "Highly Satisfactory",
                "Satisfactory",
                "Moderately Satisfactory",
                "Moderately Unsatisfactory",
                "Unsatisfactory",
                "Highly Unsatisfactory"
              ]
            }
          }
        },
        "overallRisk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous"
          ],
          "properties": {
            "previous": {
              "enum": [
                "Low",
                "Moderate",
                "Substantial",
                "High"
              ]
            },
            "current": {
              "enum": [
                "Low",
                "Moderate",
                "Substantial",
                "High"
              ]
            }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicators"
      ],
      "properties": {
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actualCurrent",
              "actualPrevious",
              "baseline",
              "endTarget",
              "indicator",
              "type",
              "unit"
            ],
            "properties": {
              "type": {
                "enum": [
                  "PDO",
                  "Intermediate"
                ]
              },
              "indicator": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "baseline": {
                "type": "number"
              },
              "actualPrevious": {
                "type": "number"
              },
              "actualCurrent": {
                "type": "number"
              },
              "endTarget": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "financing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled",
        "currency",
        "disbursed",
        "loanId",
        "original",
        "revised",
        "undisbursed"
      ],
      "properties": {
        "loanId": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "const": "USD"
        },
        "original": {
          "type": "integer",
          "minimum": 0
        },
        "revised": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "disbursed": {
          "type": "integer",
          "minimum": 0
        },
        "undisbursed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "currency"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractPeriod",
              "contractValue",
              "method",
              "ocid",
              "paymentApprover",
              "payments",
              "physicalProgress",
              "status",
              "supplier",
              "title"
            ],
            "properties": {
              "ocid": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pending",
                  "active",
                  "complete",
                  "cancelled"
                ]
              },
              "supplier": {
                "type": "string",
                "minLength": 1
              },
              "contractValue": {
                "type": "integer",
                "minimum": 0
              },
              "contractPeriod": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "end",
                  "start"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              },
              "paymentApprover": {
                "type": "string",
                "minLength": 1
              },
              "payments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "amount",
                    "date",
                    "reference"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "physicalProgress": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asOf",
                  "kmBuilt",
                  "kmTotal",
                  "unit"
                ],
                "properties": {
                  "asOf": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "kmBuilt": {
                    "type": "number",
                    "minimum": 0
                  },
                  "kmTotal": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asOf",
        "locations",
        "milestones"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dateMet",
              "dueDate",
              "id",
              "status",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "dueDate": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "dateMet": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "scheduled",
                  "met",
                  "notMet",
                  "partiallyMet"
                ]
              }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "geometry",
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "geometry": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "coordinates",
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "Point"
                      },
                      "coordinates": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "coordinates",
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "LineString"
                      },
                      "coordinates": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ],
                          "items": false,
                          "minItems": 2
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitments",
        "grievances",
        "riskRating"
      ],
      "properties": {
        "riskRating": {
          "enum": [
            "Low",
            "Moderate",
            "Substantial",
            "High"
          ]
        },
        "commitments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "deadline",
              "status"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "deadline": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "status": {
                "enum": [
                  "Completed",
                  "Ongoing",
                  "Not started"
                ]
              }
            }
          }
        },
        "grievances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "date",
              "status"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "Open",
                  "Resolved"
                ]
              }
            }
          }
        }
      }
    },
    "agreed-actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "mission",
        "summary"
      ],
      "properties": {
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "deadline",
              "responsible",
              "status"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "responsible": {
                "type": "string",
                "minLength": 1
              },
              "deadline": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "status": {
                "enum": [
                  "Completed",
                  "Ongoing",
                  "Not started"
                ]
              }
            }
          }
        }
      }
    },
    "road-checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choices",
        "settings",
        "survey"
      ],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form_id",
            "form_title",
            "version"
          ],
          "properties": {
            "form_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "form_title": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "survey": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "name",
              "label"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "list_name",
              "name"
            ],
            "properties": {
              "list_name": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
